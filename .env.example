# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Nunca envie o .env.local para o GitHub.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só no site de demonstração do portfólio (projeto separado na Vercel):
# liga a faixa de demonstração e mostra o acesso de demonstração no login.
# No site real da Marlene, deixe VITE_MODO_DEMO vazio ou false.
VITE_MODO_DEMO=
VITE_DEMO_EMAIL=
VITE_DEMO_SENHA=
